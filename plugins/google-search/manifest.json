{
  "id": "onicord-google-search",
  "name": "Google Search",
  "icon": "assets/icon.png",
  "version": "1.1.0",
  "author": "Oniverse",
  "description": "Busca información en Google e IA y publica el resultado formateado en el chat.",
  "main": "index.js",
  "commands": [
    {
      "command": "/g",
      "description": "Busca en la web o limpia el historial (/g clear)."
    }
  ],
  "defaultConfig": {
    "prefix": "/g",
    "showInIsland": true,
    "language": "es"
  },
  "configSchema": [
    {
      "key": "language",
      "label": "Idioma preferido de búsqueda",
      "type": "text",
      "default": "es"
    }
  ],
  "permissions": [
    "chat.read",
    "chat.send",
    "p2p.network",
    "network.outbound"
  ]
}